# Скопируйте в .env (он в .gitignore) и подставьте свои значения.
# Подойдёт любой OpenAI-compatible Chat Completions API с поддержкой tool calling.

# Вариант 1: локальная Ollama (ollama pull qwen3:4b && ollama serve)
OPENAI_BASE_URL=http://localhost:11434/v1/
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:4b

# Вариант 2: облачный сервис с бесплатным лимитом (пример формата)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=<ваш ключ>
# OPENAI_MODEL=<модель с поддержкой tools>
